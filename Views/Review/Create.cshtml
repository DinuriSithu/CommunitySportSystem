@model CommunitySportSystem.ViewModels.ReviewViewModel

@{
    ViewBag.Title = "Submit Review";
}

<div class="container">

    <h2>Submit Review</h2>

    <p>Share your experience with this sports facility.</p>

    <hr />

    <div class="row">

        <div class="col-md-8">

            <div class="panel panel-primary">

                <div class="panel-heading">
                    <h3 class="panel-title">Facility Review</h3>
                </div>

                <div class="panel-body">

                    @using (Html.BeginForm("Create", "Review", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(model => model.FacilityID)

                        @Html.ValidationSummary(true, "",
                            new { @class = "text-danger" })

                        <div class="form-group">

                            @Html.LabelFor(model => model.FacilityName)

                            @Html.TextBoxFor(model => model.FacilityName,
                                new
                                {
                                    @class = "form-control",
                                    @readonly = "readonly"
                                })

                        </div>

                        <div class="form-group">

                            @Html.LabelFor(model => model.Rating)

                            <select name="Rating" class="form-control">

                                <option value="">Select Rating</option>
                                <option value="1">1 - Very Poor</option>
                                <option value="2">2 - Poor</option>
                                <option value="3">3 - Average</option>
                                <option value="4">4 - Good</option>
                                <option value="5">5 - Excellent</option>

                            </select>

                            @Html.ValidationMessageFor(
                                model => model.Rating,
                                "",
                                new { @class = "text-danger" })

                        </div>

                        <div class="form-group">

                            @Html.LabelFor(model => model.Comment)

                            @Html.TextAreaFor(model => model.Comment,
                                new
                                {
                                    @class = "form-control",
                                    rows = "5",
                                    placeholder = "Write your review here..."
                                })

                            @Html.ValidationMessageFor(
                                model => model.Comment,
                                "",
                                new { @class = "text-danger" })

                        </div>

                        <br />

                        <button type="submit"
                                class="btn btn-primary">
                            Submit Review
                        </button>

                        <a href="@Url.Action("Reviews", "Review")"
                           class="btn btn-default">
                            View Reviews
                        </a>

                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}